# API
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# Frontend (leave blank to use the Vite /api development proxy)
VITE_API_URL=

# Local PostgreSQL used by Docker Compose and Prisma
POSTGRES_USER=reqflow
POSTGRES_PASSWORD=reqflow_dev_password
POSTGRES_DB=reqflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://reqflow:reqflow_dev_password@localhost:5432/reqflow?schema=public
