{
  "name": "reqflow",
  "version": "0.1.0",
  "private": true,
  "description": "Requirements Management & Business Analysis Platform",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace @reqflow/web",
    "dev:api": "npm run dev --workspace @reqflow/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspace @reqflow/api",
    "prisma:generate": "node --env-file=.env apps/api/node_modules/prisma/build/index.js generate --schema apps/api/prisma/schema.prisma",
    "prisma:validate": "node --env-file=.env apps/api/node_modules/prisma/build/index.js validate --schema apps/api/prisma/schema.prisma"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "concurrently": "9.2.4"
  }
}
